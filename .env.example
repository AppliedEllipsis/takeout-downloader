# =============================================================================
# Google Takeout Downloader - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The web server reads these on startup.
# =============================================================================

# --- Authentication (REQUIRED for remote/production use) ---
# If both are set, the web UI requires HTTP Basic Auth.
# If unset, a WARNING is printed and the server runs unauthenticated (local dev only).
AUTH_USER=admin
AUTH_PASS=changeme

# --- Flask ---
# Secret key for session signing. If unset, a random key is generated each startup
# (which invalidates sessions on restart — fine for single-use, bad for persistence).
SECRET_KEY=

# --- CORS ---
# Comma-separated list of allowed origins for SocketIO.
# Default: http://localhost:5000
# For remote server: https://your-domain.com,http://your-server:5001
CORS_ORIGINS=http://localhost:5000

# --- Downloads ---
# Base directory for downloaded takeout archives.
# Must be within an allowed directory (cwd, home, /opt/, /downloads/, /tmp/).
# /opt/takeout is the default — mounted via docker-compose or created by the Dockerfile.
OUTPUT_DIR=/opt/takeout

# Number of parallel file downloads (1-20).
PARALLEL_DOWNLOADS=6

# Maximum number of takeout parts to attempt (1-1000).
FILE_COUNT=100

# --- aria2c Integration ---
# Set to "true" to use aria2c as the download backend (if available).
# Falls back to Python requests if aria2c is not found.
ARIA2C_ENABLED=false

# JSON-RPC URL for an already-running aria2c daemon.
# If ARIA2C_ENABLED=true and this is unset, aria2c is auto-started.
ARIA2C_RPC_URL=http://localhost:6800/jsonrpc

# RPC secret token for aria2c. If unset when auto-starting, a random one is generated.
ARIA2C_RPC_SECRET=

# Number of connections per file when using aria2c (1-16).
ARIA2C_SPLIT=16

# --- Advanced ---
# Maximum retries per file on transient network errors (default: 3).
MAX_RETRIES=3

# Base seconds for exponential backoff between retries (default: 2.0).
RETRY_BACKOFF=2.0
