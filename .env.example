# =============================================================================
# Google Takeout Downloader - Configuration
# =============================================================================
# Copy this file to .env and fill in your values. All values are OPTIONAL —
# the TUI works without any .env at all. These just change the defaults that
# pre-fill the TUI input fields.
#
# The TUI is the only interface. There is no web server, no auth, and no
# network listener: payloads come from the browser extension via your
# clipboard (Copy as JSON → paste into the TUI).
# =============================================================================

# --- Downloads ---
# Default output directory for downloaded takeout archives.
# Must be within an allowed directory (see ALLOWED_DIRS below). The TUI
# remembers your last-used directory across runs, so this is just the
# first-launch default.
OUTPUT_DIR=./downloads

# Default number of parallel file downloads (1-20).
PARALLEL_DOWNLOADS=1

# Default maximum number of takeout parts to attempt (1-1000).
FILE_COUNT=100

# --- Paths ---
# Extra directories the output dir is allowed to live in, on top of the
# built-in set (cwd, home, /opt/, /downloads/, /tmp/). os.pathsep-separated
# (":" on Linux/macOS, ";" on Windows). Symlinks are resolved before the
# check, so ./downloads/opt -> /opt validates against /opt. Useful for a
# JuiceFS / NAS mount that isn't under a default prefix.
# ALLOWED_DIRS=/opt:/mnt/nas

# Where the TUI persists last-used settings (output dir, file count,
# parallel). Defaults to ~/.takeout_downloader.json. In Docker this is
# pointed at a mounted volume so it survives `--rm`.
# TAKEOUT_SETTINGS=/downloads/.takeout_settings.json

# --- Retries ---
# Maximum retries per file on transient network errors (429/503/5xx/network).
# Raised to 6 because large exports throw transient errors that usually
# recover (lesson from tarballz/mass-takeout-downloader).
MAX_RETRIES=6

# Base seconds for exponential backoff between retries. Backoff is jittered
# (random 0..base^attempt) to stop parallel workers retrying in lockstep.
RETRY_BACKOFF=2.0

# Cap on a single backoff sleep, in seconds. Prevents a worker stalling for
# minutes on a late attempt, and clamps any hostile Retry-After header.
RETRY_MAX_WAIT=120.0
