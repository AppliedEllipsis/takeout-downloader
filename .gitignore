# =============================================================================
# Secrets & credentials — DO NOT COMMIT
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
cookies.*
curl_*.txt
auth_*.txt
ssh_run.py

# =============================================================================
# Runtime / downloaded data — never belongs in source control
# =============================================================================
downloads/*
!downloads/.gitkeep
takeout-*.zip
*.zip
*.tgz
*.tar.gz
*.tbz2
*.partial
*.downloading

# =============================================================================
# Local test / scratch artifacts
# =============================================================================
_tmp/
_tmp*
_final_test*
test_*.txt
*.test.json
*.test.log

# Generated malware-analysis fixtures (built fresh at test time, never committed)
fakegit_demo_*/
fakegit_fixture_*/
_malware_scratch/

# =============================================================================
# Outscorn directory — removed from history; do NOT re-add
# (See NOTICE.md — these zips contained suspicious payloads.)
# =============================================================================
outscorn/
outscorn/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# =============================================================================
# Virtual environments
# =============================================================================
venv/
.venv/
env/
ENV/

# =============================================================================
# PyInstaller / build artifacts
# =============================================================================
build/
dist/
*.spec
*.exe
*.app

# =============================================================================
# Chrome / browser extension build artifacts
# =============================================================================
helpers/*.crx
helpers/*.pem
helpers/icons/
helpers/build/

# =============================================================================
# IDE / editor
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~

# =============================================================================
# OS junk
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# Payload drop box (host-written in.json etc.)
drop/*
!drop/.gitkeep

# TUI runtime logs (TAKEOUT_LOG_FILE)
takeout.log
downloads/*.log

# Pi agent research/scratch dir (local tooling, not project code)
.pi/
.commit_scratch/
# Windows null device — never commit
nul

# Manager service local venv (Phase 2+)
.venv-manager/
manager/**/__pycache__/

# Hosted-browser profile (KasmVNC /config): live Google session — NEVER commit
config/

# Stray root-level doc drafts — canonical copies live in docs/webgui/
/11-session-changes.md
/12-operations-runbook.md
/13-migration-diskfull.md
/14-resume-cookies-multiaccount.md
/15-status-panel-archives-startmd.md

