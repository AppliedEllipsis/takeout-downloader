# Self-contained Google Takeout downloader CLI (internal downloader, no aria2c).
# Build: docker build -f Dockerfile.takeout_dl -t takeout-dl .
# Run:   docker run --rm -it -v /srv/storage/google-takeout/my-takeout:/downloads \
#          -v /path/to/payload.json:/payload.json takeout-dl --payload /payload.json --out /downloads
FROM python:3.12-slim

RUN pip install --no-cache-dir requests

WORKDIR /app
COPY takeout_dl.py /app/

ENV PYTHONUNBUFFERED=1
ENV OUTPUT_DIR=/downloads

ENTRYPOINT ["python", "/app/takeout_dl.py"]
