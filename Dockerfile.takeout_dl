# Self-contained Google Takeout downloader CLI.
# Build: docker build -f Dockerfile.takeout_dl -t takeout-dl .
# Run:  docker run --rm -it -v /srv/storage/google-takeout/my-takeout:/downloads takeout-dl
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends aria2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir requests

WORKDIR /app
COPY takeout_dl.py /app/

ENV PYTHONUNBUFFERED=1
ENV OUTPUT_DIR=/downloads

ENTRYPOINT ["python", "/app/takeout_dl.py"]
