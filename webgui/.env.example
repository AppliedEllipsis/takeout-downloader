# Takeout web-hosted browser + manager — deployment config.
# Copy to .env at the repo root:  cp webgui/.env.example .env
# File mode 600 (chmod 600 .env). NEVER commit .env — .gitignore covers it.

# --- storage ---
# Output root. Archives land under $STORAGE_ROOT/google-takeout/<account>/<export-ts>/
STORAGE_ROOT=/opt
TZ=Etc/UTC

# --- manager auth tokens ---
# Generate strong random values, e.g.:  openssl rand -hex 32
# API token gates the control plane (pause/resume/cancel/recapture/diagnose).
MANAGER_API_TOKEN=
# Capture token is NARROW: it only allows POST /api/payload + recapture-pending.
# This is the one the extension holds (seeded into the profile, see below).
MANAGER_CAPTURE_TOKEN=

# Public URL of the manager as seen from inside the desktop browser tab.
MANAGER_PUBLIC_URL=http://127.0.0.1:8080

# --- telegram (see docs/webgui/06-telegram.md) ---
# Token = telegram.token from ~/.pi/agent/auth.json. Chat id captured once via:
#   python -m manager.notify --capture-chat-id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- cloudflare tunnel ---
# Token mode (simplest): paste the tunnel token from the Cloudflare dashboard.
# Then point the dashboard public hostname at http://127.0.0.1:3000 and gate it
# with Cloudflare Access. Leave empty if using config.yml credentials instead.
CLOUDFLARE_TUNNEL_TOKEN=
